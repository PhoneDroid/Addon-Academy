
{%- assign url = page.dir -%}
{%- assign crumbs = url | remove_first : '/' | split : '/' -%}

{%- if crumbs.size > 0 -%}

    <nav>
        <ul>

            <li>
                <a href = '/' >
                    🏠
                </a>
            </li>

            {%- assign path = '' -%}

            {%- for crumb in crumbs -%}

                {%- capture path -%}
                    {{- path -}}
                    {{- '/' -}}
                    {{- crumb -}}
                {%- endcapture -%}

                <li> » </li>

                <li>
                    <a href = '{{- path -}}' >
                        {{- crumb -}}
                    </a>
                </li>

            {%- endfor -%}

        </ul>
    </nav>

{%- endif -%}
